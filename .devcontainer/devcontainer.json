// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
	"name": "Debian",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	// Remove or uncomment the following `runArgs` to enable GPU support on hosts
	// that have NVIDIA drivers and the NVIDIA Container Toolkit installed.
	"runArgs": [
		"--gpus",
		"all"
	],
	"containerEnv": {
		"NVIDIA_DRIVER_CAPABILITIES": "all"
	},
	"features": {
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers-extra/features/ffmpeg-apt-get:1": {}
	},
	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},
	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	// Configure tool-specific properties.
	// "customizations": {},
	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
	// Run a lightweight check after the container is created to show GPU info if available.
	"postCreateCommand": "bash -lc 'if command -v nvidia-smi >/dev/null 2>&1; then nvidia-smi; else echo \"nvidia-smi not found inside container. Ensure host has NVIDIA drivers and the NVIDIA Container Toolkit installed.\"; fi'"
}