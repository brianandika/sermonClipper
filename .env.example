# PostgreSQL connection string used by the API and worker.
DATABASE_URL=postgresql://sermon_clipper:sermon_clipper@localhost:5432/sermon_clipper?schema=public

# Redis connection string used for BullMQ queues.
REDIS_URL=redis://localhost:6379

# Port used by the API when running locally.
API_PORT=3000

# Days before inactive sessions expire.
SESSION_TTL_DAYS=90

# Days before result records expire.
RESULT_TTL_DAYS=90

# Days before unused assets can be deleted by cleanup.
ASSET_TTL_DAYS=90

# Days before old terminal jobs can be deleted by cleanup.
JOB_TTL_DAYS=90

# Minutes between cleanup scans for expired sessions, jobs, and assets.
CLEANUP_INTERVAL_MINUTES=60

# Root working directory for uploads, generated artifacts, and intermediate processing files.
WORK_ROOT=/workspaces/sermonClipper/work

# Path to the ffmpeg executable.
FFMPEG_PATH=ffmpeg

# Path to the ffprobe executable.
FFPROBE_PATH=ffprobe

# Maximum upload size in bytes (default: 50 GiB).
UPLOAD_MAX_BYTES=53687091200

# Worker queue mode. Normal local value is `all`.
WORKER_MODE=all

# Number of concurrent CPU queue jobs.
CPU_WORKER_CONCURRENCY=2

# Number of concurrent GPU encode jobs.
GPU_WORKER_CONCURRENCY=1

# Seconds between automatic periodic PostgreSQL backups (docker `postgres-backup` service).
BACKUP_INTERVAL_SECONDS=600

# Number of minutes to retain PostgreSQL backup files in ./backups/postgres.
BACKUP_RETENTION_MINUTES=60

# --- Local transcription (faster-whisper) ---
# Each processed sermon also exports a timestamped WebVTT (.vtt) transcript. Runs fully local.
# Set to false to disable transcript generation.
ENABLE_TRANSCRIPTION=true
# Whisper model id, downloaded on first job into WHISPER_MODEL_DIR.
WHISPER_MODEL=large-v3-turbo
# Where the model is cached. Defaults to ${WORK_ROOT}/_models so it persists in
# the shared work volume and is downloaded only once.
WHISPER_MODEL_DIR=/workspaces/sermonClipper/work/_models
# auto = use the NVIDIA GPU if available, otherwise CPU. Force with: cpu | cuda
WHISPER_DEVICE=auto
# auto = float16 on GPU, int8 on CPU. Force with: int8 | float16 | float32
WHISPER_COMPUTE_TYPE=auto
# Force a language to skip auto-detection. Use "auto" to let Whisper detect it.
WHISPER_LANGUAGE=en
# Python executable used to run the transcription script.
PYTHON_PATH=python3

# --- AI shorts suggestions (Google Gemini) ---
# Powers the "✨ Suggest clips" button in the Shorts tab: sends a source's
# transcript to Gemini and gets back suggested clip moments (start/end + heading
# + why-it's-shareable). Leave GEMINI_API_KEY blank to disable the feature —
# the endpoint then returns a clear "not configured" message.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Gemini model to use. gemini-2.5-flash is fast, free-tier friendly, and has a
# large context window that fits a whole sermon transcript in one call.
GEMINI_MODEL=gemini-2.5-flash
