generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum JobStatus {
  queued
  preparing
  processing_audio
  encoding_video
  encoding_audio
  completed
  failed
  canceled
  expired
}

enum HardwareOption {
  auto
  cpu
  cuda
  intel
  apple
  vaapi
}

model Session {
  id             String              @id @default(uuid())
  createdAt      DateTime            @default(now())
  lastActivityAt DateTime            @default(now())
  expiresAt      DateTime
  assets         Asset[]
  jobs           Job[]
  results        Result[]
  credentials    YouTubeCredential[]
}

model Asset {
  id               String   @id @default(uuid())
  sessionId        String
  originalFilename String
  mimeType         String
  fileSize         BigInt
  sourcePath       String
  peaksPath        String?
  fps              Float?
  duration         Float?
  status           String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  jobs             Job[]

  @@index([sessionId])
}

model Job {
  id                String               @id @default(uuid())
  sessionId         String
  assetId           String
  status            JobStatus            @default(queued)
  requestedHardware HardwareOption       @default(auto)
  effectiveHardware HardwareOption?
  payloadJson       Json
  queueName         String
  failureReason     String?
  createdAt         DateTime             @default(now())
  startedAt         DateTime?
  finishedAt        DateTime?
  session           Session              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  asset             Asset                @relation(fields: [assetId], references: [id], onDelete: Cascade)
  progress          JobProgress?
  result            Result?
  artifacts         ProcessingArtifact[]

  @@index([sessionId])
  @@index([assetId])
  @@index([status])
}

model JobProgress {
  jobId           String   @id
  stage           String
  stageProgress   Int
  overallProgress Int
  message         String
  updatedAt       DateTime @updatedAt
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Result {
  id           String   @id @default(uuid())
  jobId        String   @unique
  sessionId    String
  videoPath    String?
  audioPath    String?
  transcriptPath String?
  manifestPath String?
  sizeBytes    BigInt?
  duration     Float?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
}

model YouTubeCredential {
  id                    String    @id @default(uuid())
  sessionId             String
  encryptedAccessToken  String
  encryptedRefreshToken String?
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  lastUsedAt            DateTime?
  session               Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ProcessingArtifact {
  id          String   @id @default(uuid())
  jobId       String
  type        String
  filename    String
  storagePath String
  sizeBytes   BigInt?
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}
